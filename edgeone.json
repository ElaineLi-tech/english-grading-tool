{
  "build": {
    "python": {
      "maxDuration": 300,
      "includeFiles": [
        "lib/**",
        "builtin_templates/**",
        "requirements.txt"
      ]
    }
  },
  "env": {
    "STORAGE_MODE": "cloud"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "cloud-functions/api/[[default]].py"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
