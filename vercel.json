{
  "version": 2,
  "functions": {
    "api/*.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/download/:path*", "destination": "/api/index" },
    { "source": "/static/:path*", "destination": "/api/index" }
  ]
}
