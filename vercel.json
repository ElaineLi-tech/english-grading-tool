{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python@4.2.3",
      "config": {
        "maxDuration": 300,
        "includeFiles": [
          "app.py",
          "templates/**",
          "templates_user/config.example.json",
          "requirements.txt"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
